# Copy to .env.local and fill in. .env.local is git-ignored.

# Brevo (Sendinblue) SMTP relay for the contact form.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Envelope sender — must be a verified sender in Brevo.
CONTACT_FROM_EMAIL=""
# Inbox that receives contact-form enquiries.
CONTACT_TO_EMAIL=""
